<?xml version="1.0" encoding="utf-8"?>
<!--
    A fixed top bar above a single ViewPager2, same shape as MG4Control and MG4Tasker.

    The three screens — ABRP, Service, Log — are the pages of that one pager, in the
    order the bar lists them. Each button goes to its page and a horizontal swipe walks
    through them all: the gesture and the button name the same thing. The pages
    themselves live in pane_abrp.xml / pane_service.xml / pane_log.xml, because a
    ViewPager2 takes its children from an adapter rather than from this file.

    Button navigation rather than Material tabs: on a vehicle screen, always-visible
    64 dp targets beat a thin tab bar. The tabs share the width left by the title and
    the About button equally (weight 1), so the row can be aimed at from memory whatever
    the translated labels are.

    No MaterialButtonToggleGroup: the group owns a checked state of its own, which would
    fight the pager for who decides the current screen. Here the pager decides alone and
    MainActivity.markCurrentPage posts isSelected — the fill, text, icon and stroke come
    from the res/color/nav_tab_*.xml selectors.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mg4_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:background="@drawable/bg_topbar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/Text.MG4.Title"
            android:layout_marginEnd="@dimen/spacing_lg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabAbrp"
            style="@style/Widget.MG4.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/tab_abrp"
            app:icon="@drawable/ic_tab_abrp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabService"
            style="@style/Widget.MG4.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/tab_service"
            app:icon="@drawable/ic_tab_service" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabLog"
            style="@style/Widget.MG4.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:text="@string/tab_log"
            app:icon="@drawable/ic_tab_log" />

        <!-- About opens a dialog, not a page: it stays a plain button so it cannot be
             mistaken for a fourth destination of the pager. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_button"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_action" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
